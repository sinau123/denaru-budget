# Supabase project (Settings → API). Only the publishable/anon key belongs here.
# Never put the service role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by `supabase start` for local Google login (supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Telegram bot (phase 2). Create the bot with @BotFather.
# Public: only the bot's username, used for the deep link in Settings.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Server only — never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Random string (A-Z, a-z, 0-9, _ and -), different from the bot token; sent by Telegram
# in X-Telegram-Bot-Api-Secret-Token. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Supabase secret (service role) key: Settings → API Keys. Used only by the webhook.
SUPABASE_SECRET_KEY=
# Public origin of the app, for links in bot replies and the webhook URL.
APP_URL=http://localhost:3000
